{
  "name": "@ahokinson/press",
  "version": "0.0.0",
  "description": "Reusable Solid + opentui TUI primitives: async, charts, clipboard, components, context, format, icons, io, keyboard, link, markdown, models, signals, terminal, theme.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/**",
    "./dist/charts/register.js",
    "./dist/charts/index.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahokinson/press.git"
  },
  "exports": {
    "./async": {
      "types": "./dist/async/index.d.ts",
      "import": "./dist/async/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard/index.d.ts",
      "import": "./dist/clipboard/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js"
    },
    "./keyboard": {
      "types": "./dist/keyboard/index.d.ts",
      "import": "./dist/keyboard/index.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "import": "./dist/link/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.3.0",
    "@opentui/solid": ">=0.3.0",
    "solid-js": "^1.9.0",
    "zod": "^3.22.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@catppuccin/palette": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@opentui/core": "^0.3.0",
    "@opentui/solid": "^0.3.0",
    "@types/bun": "latest",
    "solid-js": "^1.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build:js": "bun run build.ts",
    "build:dts": "tsup",
    "build": "bun run build:js && bun run build:dts",
    "typecheck": "tsc --noEmit",
    "format": "biome check --fix src",
    "lint": "biome check src",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "prepare": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build"
  }
}
